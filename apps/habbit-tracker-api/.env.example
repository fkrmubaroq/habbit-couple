# General
PORT=7070
NODE_ENV=development

# WAJIB sama persis dengan JWT_SECRET di apps/finance-tracker-api/.env
# agar session (cookie) bisa dipakai lintas app.
JWT_SECRET=change-me-to-a-long-random-string

# Shared session cookie across subdomains, contoh: .pasutri.com
# Kosongkan saat development di localhost (cookie otomatis shared karena cookie mengabaikan port).
COOKIE_DOMAIN=

# Origin yang boleh dipakai sebagai `returnTo` setelah login (comma-separated, exact origin)
ALLOWED_REDIRECT_ORIGINS=http://localhost:5051,http://localhost:6061,http://localhost:7071,http://localhost:8081

# Origin frontend yang boleh mengakses API (comma-separated)
ALLOW_ORIGIN_CORS=http://localhost:5051,http://localhost:6061,http://localhost:7071,http://localhost:8081

# Database Provider selection: mysql | supabase
DB_PROVIDER=mysql

# MySQL Configuration (uncomment if DB_PROVIDER=mysql)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=habbit_couple
MYSQL_PORT=3306

# Supabase / PostgreSQL Configuration (uncomment if DB_PROVIDER=supabase)
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
