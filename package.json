{
  "name": "habbit-tracker-couple",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:migrate": "turbo run db:migrate --filter=@repo/habbit-tracker-api",
    "db:seed": "turbo run db:seed --filter=@repo/habbit-tracker-api",
    "db:migrate:finance": "turbo run db:migrate --filter=@repo/finance-tracker-api",
    "db:seed:finance": "turbo run db:seed --filter=@repo/finance-tracker-api",
    "db:migrate:grocery": "turbo run db:migrate --filter=@repo/grocery-tracker-api",
    "db:seed:grocery": "turbo run db:seed --filter=@repo/grocery-tracker-api",
    "db:migrate:pomodoro": "turbo run db:migrate --filter=@repo/pomodoro-tracker-api",
    "db:seed:pomodoro": "turbo run db:seed --filter=@repo/pomodoro-tracker-api",
    "db:migrate:all": "turbo run db:migrate",
    "db:seed:all": "turbo run db:seed",
    "db:migrate:prod": "node scripts/deploy-db-migrate.mjs --task migrate",
    "db:seed:prod": "node scripts/deploy-db-migrate.mjs --task seed",
    "db:setup:prod": "node scripts/deploy-db-migrate.mjs --task migrate,seed",
    "migrate:all": "turbo run db:migrate",
    "test:finance-api": "node apps/finance-tracker-api/tests/qa-api-runner.mjs",
    "test:finance-auth": "node apps/finance-tracker-api/tests/qa-auth-logout-runner.mjs",
    "test:finance-theme": "node apps/finance-tracker-web/tests/qa-theme-runner.mjs",
    "test:finance-ui": "node apps/finance-tracker-web/tests/qa-ui-components-runner.mjs",
    "clean": "turbo run clean",
    "deploy:env": "node scripts/deploy-env.mjs",
    "deploy:env:vps": "node scripts/deploy-env-ssh.mjs",
    "deploy:ssh": "node scripts/deploy-env-ssh.mjs",
    "deploy:nginx": "node scripts/deploy-nginx.mjs",
    "deploy": "node scripts/deploy-app.mjs",
    "deploy:app": "node scripts/deploy-app.mjs",
    "deploy:refresh": "node scripts/deploy-app.mjs --refresh",
    "deploy:full": "pnpm run deploy && pnpm run deploy:env:vps && pnpm run deploy:refresh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@12.9.1"
}
